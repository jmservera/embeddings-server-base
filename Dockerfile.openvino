# syntax=docker/dockerfile:1
FROM openvino/ubuntu24_runtime:2025.4.0

ARG MODEL_NAME=intfloat/multilingual-e5-base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/models/huggingface \
    SENTENCE_TRANSFORMERS_HOME=/models/sentence_transformers

USER root

# Create app user (uid 1000) — consistent with the app image
RUN groupadd --system --gid 1000 app 2>/dev/null || true && \
    useradd --system --uid 1000 --gid app --create-home app 2>/dev/null || true

RUN mkdir -p /models /app

WORKDIR /app

# Create .venv and install heavy deps using uv (mounted transiently, not in image).
# The openvino package from the base image PYTHONPATH remains available, but
# optimum-intel and sentence-transformers are installed in .venv for portability.
RUN --mount=from=ghcr.io/astral-sh/uv:latest,source=/uv,target=/usr/local/bin/uv \
    uv venv /app/.venv && \
    VIRTUAL_ENV=/app/.venv uv pip install --no-cache sentence-transformers huggingface_hub optimum-intel

ENV PATH="/app/.venv/bin:${PATH}"

# Download model, export to OpenVINO IR, and save to a known local path.
# HF_TOKEN is mounted as a build secret — never stored in image layers.
RUN --mount=type=secret,id=HF_TOKEN \
    export HF_TOKEN="$(cat /run/secrets/HF_TOKEN 2>/dev/null || true)" && \
    python3 -c "from sentence_transformers import SentenceTransformer; m = SentenceTransformer('${MODEL_NAME}', backend='openvino'); m.save('/models/sentence_transformers/$(echo ${MODEL_NAME} | tr / _)')"

# Verify offline loading from local path — fails the build if cache is incomplete.
RUN HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 python3 -c "\
from sentence_transformers import SentenceTransformer; \
m = SentenceTransformer('/models/sentence_transformers/$(echo ${MODEL_NAME} | tr / _)', backend='openvino'); \
print(f'OK dim={m.get_sentence_embedding_dimension()}')"

# Own /app to app user; /models stays root-owned, world-readable
RUN chown -R app:app /app && chmod -R a+rX /models

USER app
