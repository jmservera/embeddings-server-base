FROM openvino/ubuntu24_runtime:2025.4.0

ARG MODEL_NAME=intfloat/multilingual-e5-base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/models/huggingface \
    SENTENCE_TRANSFORMERS_HOME=/models/sentence_transformers

USER root

RUN mkdir -p /models

# Install only what's needed to download the model in OpenVINO IR format.
# The openvino Python package is already provided by the base image via PYTHONPATH;
# optimum-intel bridges HuggingFace models ↔ OpenVINO IR conversion.
RUN pip install --no-cache-dir sentence-transformers huggingface_hub optimum-intel

# Download model, export to OpenVINO IR, and save to a known local path.
# HF_TOKEN is mounted as a build secret — never stored in image layers.
RUN --mount=type=secret,id=HF_TOKEN \
    export HF_TOKEN="$(cat /run/secrets/HF_TOKEN 2>/dev/null || true)" && \
    python3 -c "from sentence_transformers import SentenceTransformer; m = SentenceTransformer('${MODEL_NAME}', backend='openvino'); m.save('/models/sentence_transformers/$(echo ${MODEL_NAME} | tr / _)')"

# Verify offline loading from local path — fails the build if cache is incomplete.
RUN HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 python3 -c "\
from sentence_transformers import SentenceTransformer; \
m = SentenceTransformer('/models/sentence_transformers/$(echo ${MODEL_NAME} | tr / _)', backend='openvino'); \
print(f'OK dim={m.get_sentence_embedding_dimension()}')"

USER openvino
